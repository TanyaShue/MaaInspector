{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaaInspector Node Details UI Configuration",
  "type": "object",
  "required": ["version", "gridColumns", "tabs", "layouts", "recognition", "action"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "gridColumns": { "type": "integer", "minimum": 1, "maximum": 24 },
    "tabs": { "type": "array", "items": { "$ref": "#/$defs/tab" } },
    "layouts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layout" } },
    "recognition": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layout" } },
    "action": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layout" } },
    "presets": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/field" } } },
    "fieldLabels": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "tab": {
      "type": "object",
      "required": ["key", "label", "icon", "renderer"],
      "properties": {
        "key": { "type": "string" }, "label": { "type": "string" }, "icon": { "type": "string" },
        "renderer": { "enum": ["basic", "flow", "focus", "json", "fields", "node-fields"] },
        "layout": { "type": "string" }, "kind": { "enum": ["recognition", "action"] }
      }
    },
    "layout": {
      "type": "object",
      "required": ["schemaDef"],
      "properties": {
        "schemaDef": { "type": "string" }, "renderer": { "enum": ["fields", "legacy"] },
        "use": { "type": "string" }, "emptyText": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "append": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "span", "control"],
      "properties": {
        "key": { "type": "string" }, "span": { "type": "integer", "minimum": 1 },
        "rowSpan": { "type": "integer", "minimum": 1 }, "label": { "type": "string" },
        "control": { "enum": ["text", "textarea", "number", "checkbox", "select", "json", "textarea-json", "target", "action"] },
        "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" },
        "optional": { "type": "boolean" }, "forceString": { "type": "boolean" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "action": {
      "type": "object", "required": ["type", "label"],
      "properties": {
        "type": { "enum": ["picker", "ocr", "image-manager", "color-range"] },
        "label": { "type": "string" }, "referenceField": { "type": ["string", "null"] }
      }
    }
  }
}
